# ── LLM provider ─────────────────────────────────────────────────────────────
# The analyst agent speaks two protocols — Anthropic Messages and OpenAI Chat
# Completions — plus a DeepSeek preset. Pick one by setting its API key below;
# each supports a custom MODEL_ID and BASE_URL so you can point it at a proxy
# or self-hosted endpoint.
#
# LLM_PROVIDER selects the protocol explicitly: `anthropic` | `openai` | `deepseek`.
# If unset, it is inferred from whichever key is configured (Anthropic wins ties).
# LLM_PROVIDER=anthropic

# ── Anthropic protocol (default) ─────────────────────────────────────────────
# Claude, or any Anthropic-compatible endpoint. Key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_ID=claude-opus-4-8
# ANTHROPIC_BASE_URL=https://api.anthropic.com      # /v1 is appended if omitted

# ── OpenAI-compatible protocol ───────────────────────────────────────────────
# Works with OpenAI, DeepSeek, OpenRouter, Together, a local vLLM/Ollama, etc.
# Set LLM_PROVIDER=openai (or just leave only OPENAI_API_KEY set).
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1         # e.g. https://api.deepseek.com/v1
# OPENAI_MODEL_ID=gpt-4o-mini                        # e.g. deepseek-chat

# ── DeepSeek preset ──────────────────────────────────────────────────────────
# Convenience over the OpenAI protocol with DeepSeek defaults + reasoning-token
# handling. Set LLM_PROVIDER=deepseek (or just leave only DEEPSEEK_API_KEY set).
# Key: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL_ID=deepseek-chat                    # or `deepseek-reasoner` (R1)
# DEEPSEEK_BASE_URL=https://api.deepseek.com         # override for a proxy

# ── Warehouse connection (v0.3) ──────────────────────────────────────────────
# The agent queries a warehouse behind a connector interface. By default it uses
# the bundled SQLite sample (`warehouse.db`) — zero setup. Point it at a live
# Postgres warehouse to ask questions of your own data. NEVER commit credentials.
#
# WAREHOUSE_PROVIDER selects explicitly: `sqlite` | `postgres`. If unset,
# Postgres is inferred when a connection below is configured; else SQLite.
# WAREHOUSE_PROVIDER=postgres
#
# Path to the SQLite sample (defaults to ./warehouse.db, created by `npm run seed`).
# WAREHOUSE_DB=./warehouse.db
#
# Postgres — a full connection string, or discrete PG* vars (pg reads them):
# DATABASE_URL=postgres://readonly_user:password@host:5432/mydb
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=mydb
# PGUSER=readonly_user            # use a least-privileged, read-only role
# PGPASSWORD=...
# PGSCHEMA=public                 # schema to introspect (default: public)
# PGSSL=require                   # enable TLS (self-signed certs accepted)
# WAREHOUSE_STATEMENT_TIMEOUT_MS=5000   # per-query timeout (defense in depth)
