									"$modelId": "f-metric-name",
									"id": "f-metric-name",
									"origin": { "name": "__metric_name__", "type": 16 },
									"group": { "type": 1 },
									"summary": { "type": 0 },
									"calculation": { "type": 0 },
									"total": { "type": "sum" }
